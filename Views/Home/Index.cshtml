@inject Tienda_Giovanna.Services.TiendaService Tienda
@{ ViewData["Title"] = "Inicio"; }
<div class="page-heading"><div><p class="eyebrow">PANEL GENERAL</p><h1>Bienvenidos a Bodega Giovanna</h1><p>Accede a las funciones principales del sistema desde el menú.</p></div></div>
<div class="cards">
  <a class="card link-card" href="@Url.Action("Ventas", "Home")"><h2>Ventas</h2><p>Seleccionar productos y calcular total y vuelto.</p><span class="more">Abrir módulo →</span></a>
  <a class="card link-card" href="@Url.Action("Inventario", "Home")"><h2>Inventario</h2><p>Revisar precios, existencias y stock bajo.</p><span class="more">Abrir módulo →</span></a>
  @if (User.IsInRole(Tienda_Giovanna.Models.Roles.Administrador))
  {
    <a class="card link-card" href="@Url.Action("Compras", "Home")"><h2>Compras</h2><p>Registrar varios productos recibidos de un proveedor.</p><span class="more">Abrir módulo →</span></a>
    <a class="card link-card" href="@Url.Action("Proveedores", "Home")"><h2>Proveedores</h2><p>Administrar distribuidores y datos de contacto.</p><span class="more">Abrir módulo →</span></a>
    <a class="card link-card" href="@Url.Action("Usuarios", "Home")"><h2>Usuarios</h2><p>Administrar cuentas y permisos.</p><span class="more">Abrir módulo →</span></a>
  }
  <a class="card link-card" href="@Url.Action("Clientes", "Home")"><h2>Clientes y fiados</h2><p>Consultar clientes, saldos e historial de pagos.</p><span class="more">Abrir módulo →</span></a>
  <a class="card link-card" href="@Url.Action("Reportes", "Home")"><h2>Reportes</h2><p>Consultar ventas por fechas y revisar sus detalles.</p><span class="more">Abrir módulo →</span></a>
</div>
@if (Tienda.ClientesEnSql || Tienda.ProveedoresEnSql || Tienda.ProductosEnSql)
{
  <div class="notice">
    @if (Tienda.ClientesEnSql)
    {
      <p>Los clientes, sus deudas y su historial de pagos se consultan desde la base de datos. Los cambios de clientes se conservan al cerrar el programa.</p>
    }
    @if (Tienda.PagosEnSql)
    {
      <p>Los abonos parciales o totales reducen la deuda y se guardan con fecha, usuario y saldo restante. Puedes consultarlos en Clientes y fiados y en los reportes por fecha.</p>
    }
    else if (Tienda.PagosPendientes)
    {
      <p>@Tienda_Giovanna.Services.TiendaService.MovimientosPendientes</p>
    }
    @if (Tienda.ProveedoresEnSql)
    {
      <p>Los proveedores también se guardan en la base de datos: sus registros, ediciones y estados se conservan al cerrar el programa.</p>
    }
    @if (Tienda.ProductosEnSql)
    {
      <p>El inventario, el stock mínimo y las alternativas se guardan en la base de datos. Puedes consultar las existencias y las alertas de reposición.</p>
      @if (Tienda.VentasPendientes)
      {
        <p>@Tienda_Giovanna.Services.TiendaService.StockPendiente</p>
      }
    }
    @if (Tienda.VentasEnSql)
    {
      <p>Las ventas se guardan con sus detalles y el usuario que las registra, descuentan stock y actualizan la deuda de los fiados. En Reportes puedes consultar el historial y los abonos existentes por fecha.</p>
    }
    @if (Tienda.ComprasEnSql)
    {
      <p>Las compras y sus detalles se guardan junto con el aumento de stock. Puedes consultar el historial de compras y el usuario que registró cada operación.</p>
    }
    else if (!Tienda.ProductosEnSql)
    {
      <p>Inventario, compras, ventas y reportes siguen con datos temporales de práctica.</p>
    }
  </div>
}
else
{
  <div class="notice">Usa datos de prueba para practicar ventas, compras y abonos. La información de estos módulos se conserva mientras la aplicación esté ejecutándose y se reinicia al cerrarla.</div>
}

