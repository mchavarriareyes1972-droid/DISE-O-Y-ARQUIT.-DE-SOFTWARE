@inject Tienda_Giovanna.Services.TiendaService Tienda
@{ ViewData["Title"] = "Clientes y fiados"; }
<div class="page-heading"><div><p class="eyebrow">CUENTAS POR COBRAR</p><h1>Clientes y fiados</h1><p>Consulta clientes, sus deudas y su historial de pagos.</p><p id="cantidadClientes" class="muted" role="status"></p></div>@if (User.IsInRole(Tienda_Giovanna.Models.Roles.Administrador)) { <button id="nuevoCliente" type="button" class="primary">Nuevo cliente</button> }</div>
@if (Tienda.ClientesEnSql)
{
    <p class="card" role="status">@Tienda_Giovanna.Services.TiendaService.MovimientosPendientes</p>
}
<section class="card"><label for="buscarCliente">Buscar por nombre o DNI</label><input id="buscarCliente" type="search" /><div class="table-wrap"><table><thead><tr><th>DNI</th><th>Cliente</th><th>Teléfono</th><th>Dirección</th><th>Deuda</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="tablaClientes"></tbody></table></div><p class="muted">Desactivar un cliente conserva su deuda y su historial.</p></section>
<section class="card spaced"><h2>Registrar pago</h2>
    <form id="formPago" data-pendiente="@Tienda.ClientesEnSql.ToString().ToLowerInvariant()"><fieldset disabled="@Tienda.ClientesEnSql"><div class="form-grid">
        <div><label for="clientePago">Cliente</label><select id="clientePago" required></select></div>
        <div><label for="montoPago">Monto del abono (S/)</label><input id="montoPago" type="number" min="0.01" step="0.01" required /></div>
        <div><label for="metodoPago">Método de pago</label><select id="metodoPago"><option>Efectivo</option><option value="Digital">Yape / Plin</option></select></div>
    </div><button class="primary" type="submit">Registrar abono</button></fieldset></form><p id="mensajeClientes" class="message" role="status"></p>
</section>
<section class="card spaced"><h2>Historial de pagos</h2><label for="filtrarPagos">Cliente</label><select id="filtrarPagos"></select><div class="table-wrap"><table><thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th>Método</th><th>Abono</th><th>Saldo restante</th></tr></thead><tbody id="tablaPagos"></tbody></table></div></section>
@if (User.IsInRole(Tienda_Giovanna.Models.Roles.Administrador))
{
<dialog id="dialogoCliente" aria-labelledby="tituloCliente"><h2 id="tituloCliente">Nuevo cliente</h2>
    <form id="formCliente"><input id="clienteEditarId" type="hidden" /><div class="form-grid">
        <div><label for="documentoCliente">DNI</label><input id="documentoCliente" pattern="[0-9]{8}" maxlength="8" inputmode="numeric" required /></div>
        <div><label for="nombreCliente">Nombre</label><input id="nombreCliente" maxlength="100" required /></div>
        <div><label for="telefonoCliente">Teléfono</label><input id="telefonoCliente" maxlength="20" /></div>
        <div><label for="direccionCliente">Dirección</label><input id="direccionCliente" maxlength="150" /></div>
    </div><small>La deuda se actualiza mediante ventas al fiado y abonos.</small><p id="mensajeClienteFormulario" class="message" role="status"></p>
    <div class="button-row"><button type="submit" class="primary">Guardar cliente</button><button type="button" id="cancelarCliente">Cancelar</button></div></form>
</dialog>
}
