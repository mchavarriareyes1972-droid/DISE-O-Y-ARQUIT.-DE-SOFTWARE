@{ ViewData["Title"] = "Proveedores"; }
<div class="page-heading"><div><p class="eyebrow">ABASTECIMIENTO</p><h1>Proveedores</h1><p>Administra distribuidores y sus datos de contacto.</p></div><button id="nuevoProveedor" type="button" class="primary">Nuevo proveedor</button></div>
<section class="card"><label for="buscarProveedor">Buscar por razón social o RUC</label><input id="buscarProveedor" type="search" /><div class="table-wrap"><table><thead><tr><th>RUC</th><th>Razón social</th><th>Contacto</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="tablaProveedores"></tbody></table></div><p id="mensajeProveedores" class="message" role="status"></p></section>
<dialog id="dialogoProveedor" aria-labelledby="tituloProveedor"><h2 id="tituloProveedor">Nuevo proveedor</h2>
    <form id="formProveedor"><input id="proveedorEditarId" type="hidden" /><div class="form-grid">
        <div><label for="rucProveedor">RUC</label><input id="rucProveedor" pattern="[0-9]{11}" maxlength="11" inputmode="numeric" required /></div>
        <div><label for="razonProveedor">Razón social</label><input id="razonProveedor" maxlength="100" required /></div>
        <div><label for="contactoProveedor">Contacto</label><input id="contactoProveedor" maxlength="100" /></div>
        <div><label for="telefonoProveedor">Teléfono</label><input id="telefonoProveedor" maxlength="20" /></div>
        <div><label for="correoProveedor">Correo</label><input id="correoProveedor" type="email" maxlength="100" /></div>
        <div><label for="direccionProveedor">Dirección</label><input id="direccionProveedor" maxlength="150" /></div>
    </div><p id="mensajeProveedorFormulario" class="message" role="status"></p><div class="button-row"><button type="submit" class="primary">Guardar proveedor</button><button type="button" id="cancelarProveedor">Cancelar</button></div></form>
</dialog>
