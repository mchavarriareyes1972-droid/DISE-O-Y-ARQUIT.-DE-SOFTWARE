@inject Tienda_Giovanna.Services.TiendaService Tienda
@{ ViewData["Title"] = "Compras"; }
<div class="page-heading"><div><p class="eyebrow">ABASTECIMIENTO</p><h1>Compras</h1><p>Registra varios productos recibidos de un proveedor.</p><p id="cantidadCompras" class="muted" role="status"></p></div></div>
@if (Tienda.ComprasEnSql)
{
}    
else if (Tienda.ComprasPendientes)
{
    <p class="notice">El registro de compras está pendiente de conexión a la base de datos.</p>
}
else if (Tienda.ProveedoresEnSql)
{
    <p class="notice">Los proveedores se consultan desde la base de datos. Las compras y existencias de esta pantalla siguen siendo de práctica y se restablecen al cerrar el programa.</p>
}
<section class="card">
    <label for="proveedorCompra">Proveedor registrado</label><select id="proveedorCompra" required></select><p id="avisoProveedor" class="muted"></p>
    <form id="formLineaCompra"><div class="form-grid">
        <div><label for="buscarCompra">Buscar producto por nombre o código</label><input id="buscarCompra" type="search" placeholder="Nombre o código" /></div>
        <div><label for="productoCompra">Producto</label><select id="productoCompra" required></select></div>
        <div><label for="cantidadCompra">Cantidad recibida</label><input id="cantidadCompra" type="number" min="1" step="1" value="1" required /></div>
        <div><label for="costoCompra">Costo unitario (S/)</label><input id="costoCompra" type="number" min="0.01" step="0.01" required /></div>
    </div><button type="submit">Agregar al detalle</button></form>
    <div class="table-wrap"><table><thead><tr><th>Producto</th><th>Cantidad</th><th>Costo unitario</th><th>Subtotal</th><th>Acción</th></tr></thead><tbody id="detalleCompra"></tbody></table></div>
    <div class="total-row"><strong>Total de compra</strong><strong id="totalCompra">S/ 0.00</strong></div>
    <form id="formCompra" data-pendiente="@Tienda.ComprasPendientes.ToString().ToLowerInvariant()"><button type="submit" class="primary" disabled>Registrar compra</button></form>
    <p id="mensajeCompra" class="message" role="status"></p>
</section>
<section class="card spaced"><h2>Historial de compras</h2><div class="table-wrap"><table><thead><tr><th>N.º</th><th>Fecha</th><th>Proveedor</th><th>Usuario</th><th>Artículos</th><th>Total</th><th>Acción</th></tr></thead><tbody id="tablaCompras"></tbody></table></div></section>
