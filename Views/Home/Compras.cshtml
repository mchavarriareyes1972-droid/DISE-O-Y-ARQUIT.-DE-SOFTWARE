@{ ViewData["Title"] = "Compras"; }
<div class="page-heading"><div><p class="eyebrow">ABASTECIMIENTO</p><h1>Compras</h1><p>Simula una compra recibida y actualiza el inventario de ejemplo.</p></div></div>
<div class="two-columns"><section class="card"><h2>Registrar compra</h2><label for="proveedor">Proveedor</label><input id="proveedor" type="text" maxlength="60" placeholder="Nombre del proveedor" /><label for="productoCompra">Producto</label><select id="productoCompra"></select><label for="cantidadCompra">Cantidad recibida</label><input id="cantidadCompra" type="number" min="1" step="1" value="1" /><button id="guardarCompra" type="button" class="primary">Registrar compra</button><p id="mensajeCompra" class="message" role="status"></p></section><section class="card"><h2>Última compra</h2><p id="ultimaCompra" class="muted">Aún no hay compras registradas en esta sesión.</p><div class="notice">La compra aumenta el stock que se muestra en Inventario.</div></section></div>
