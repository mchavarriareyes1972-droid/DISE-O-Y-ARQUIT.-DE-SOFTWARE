@model Tienda_Giovanna.Models.LoginSolicitud
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Iniciar sesión - Bodega Giovanna</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="login-page"><main class="card login-card">
    <p class="eyebrow">BODEGA GIOVANNA</p><h1>Iniciar sesión</h1><p>Ingresa con tu cuenta para acceder al sistema.</p>
    <form method="post" asp-controller="Cuenta" asp-action="Login">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="message error" role="alert"></div>
        <label for="login">Usuario</label><input id="login" name="Login" value="@Model.Login" maxlength="30" autocomplete="username" required />
        <label for="password">Contraseña</label><input id="password" name="Password" type="password" maxlength="100" autocomplete="current-password" required />
        <button type="submit" class="primary full">Ingresar</button>
    </form>
    <p class="muted">Proyecto académico. Los datos de práctica se restablecen al reiniciar la aplicación.</p>
</main></body></html>
