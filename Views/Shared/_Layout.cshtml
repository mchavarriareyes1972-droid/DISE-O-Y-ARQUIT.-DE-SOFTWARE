<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Bodega Giovanna</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-api-base="@Url.Content("~/api/tienda/")" data-users-base="@Url.Content("~/api/usuarios")" data-login-url="@Url.Action("Login", "Cuenta")" data-admin="@User.IsInRole(Tienda_Giovanna.Models.Roles.Administrador).ToString().ToLowerInvariant()">
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><span class="brand-icon">G</span><div><strong>Bodega Giovanna</strong><small>Sistema de gestión</small></div></div>
      <p class="menu-label">MENÚ PRINCIPAL</p>
      <nav aria-label="Menú principal">
        <a href="@Url.Action("Index", "Home")">Inicio</a>
        <a href="@Url.Action("Ventas", "Home")">Ventas</a>
        <a href="@Url.Action("Inventario", "Home")">Inventario</a>
        @if (User.IsInRole(Tienda_Giovanna.Models.Roles.Administrador))
        {
            <a href="@Url.Action("Compras", "Home")">Compras</a>
            <a href="@Url.Action("Proveedores", "Home")">Proveedores</a>
            <a href="@Url.Action("Usuarios", "Home")">Usuarios</a>
        }
        <a href="@Url.Action("Clientes", "Home")">Clientes y fiados</a>
        <a href="@Url.Action("Reportes", "Home")">Reportes</a>
      </nav>
      <div class="sidebar-foot">Proyecto académico · MVC</div>
    </aside>
    <div class="main-area">
      <header class="topbar"><span>Bodega Giovanna / @ViewData["Title"]</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="button-row"><span>@User.Identity.Name · @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                <form method="post" asp-controller="Cuenta" asp-action="Salir"><button type="submit">Cerrar sesión</button></form>
            </div>
        }
      </header>
      <main class="content">@RenderBody()</main>
      <footer>Datos temporales mientras la aplicación esté abierta · Bodega Giovanna</footer>
    </div>
  </div>
  <div hidden>@Html.AntiForgeryToken()</div>
  <dialog id="dialogoDetalle"><h2 id="tituloDetalle"></h2><div id="contenidoDetalle"></div><button id="cerrarDetalle" type="button">Cerrar</button></dialog>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/gestion.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

